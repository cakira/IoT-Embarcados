    {
        "id": "f212b31ae5d56cc0",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Format as table",
        "func": "var sensors = flow.get('sensorData') || {};\nvar tableArray = [];\n\n// Loop through each sensor ID (\"1\", \"2\", \"3\"...)\n// and push the object into the array\nfor (var id in sensors) {\n    if (sensors.hasOwnProperty(id)) {\n        var data = sensors[id];\n\n        tableArray.push({\n            \"Sensor\": id,\n            \"Latitude\": data.lat,\n            \"Longitude\": data.lon,\n            \"Temp (°C)\": data.temp\n        });\n    }\n}\n\n// The user interface widget expects data in msg.payload\nmsg.payload = tableArray;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 760,
        "y": 340,
        "wires": [
            [
                "273d73f9da2c37c1",
                "13bc528fa8d9fd51"
            ]
        ]
    },
