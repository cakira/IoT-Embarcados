    {
        "id": "97ec557e36ee8066",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Store in sensorData",
        "func": "// The topic comes in as \".../sensor/1\", \".../sensor/2\", etc.\n// We split the string to get the ID \"1\", \"2\", or \"3\"\nvar sensorID = msg.topic.split(\"/\").at(-1);\n\n// We get the current list of sensors from memory (or create an empty one)\nvar sensors = flow.get('sensorData') || {};\n\n// We save the payload (lat, lon, temp) into this object\nsensors[sensorID] = msg.payload;\n\n// Write it back to memory\nflow.set('sensorData', sensors);\n\n// We don't return anything because this is just storage.\nmsg.payload = true;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 320,
        "wires": [
            [
                "f212b31ae5d56cc0"
            ]
        ]
    },
    {
        "id": "57f5d8cc8c5dde9e",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Format request for ThingSpeak",
        "func": "var requestedX = flow.get('requested_latitude');\nvar requestedY = flow.get('requested_longitude');\n\nif (!requestedX || !requestedY) {\n    node.warn(\"Missing latitude or longitude\");\n    return null;\n}\n\n// Generate a unique 6-digit Request ID\nvar req_id = Date.now() % 1000000;\n\n// Save the Request ID to the flow memory so it can be\n// verified by the \"Process Result\" function node\nflow.set('current_request_id', req_id);\n\n// Build the payload for ThingSpeak Channel 2 (Requests)\nmsg.payload = {\n    \"api_key\": \"VU1D5XND06JGYQZ0\",\n    \"field1\": req_id,\n    \"field2\": requestedX,\n    \"field3\": requestedY\n};\n\nmsg.headers = {\n    \"Content-Type\": \"application/json\"\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 550,
        "y": 820,
        "wires": [
            [
                "471eefd8dc121569",
                "bcff5f4ca3260bc1"
            ]
        ]
    },
