    {
        "id": "a494092a99d988c5",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Process Result",
        "func": "// The Response if formated as a JSON object\nvar data = msg.payload;\n\n// Retrieve the Request ID in the Response\nvar expected_id = flow.get('current_request_id');\n\n// Verify this MQTT message belongs to our latest request\nif (data.field1 && Number(data.field1) === expected_id) {\n    \n    var estimatedTemp = Number(data.field2);\n    var requestedX = flow.get('requested_latitude');\n    var requestedY = flow.get('requested_longitude');\n\n    // Rebuild the Ubidots payload\n    var newMsg = {\n        payload: {\n            \"position\": {\n                \"value\": estimatedTemp,\n                \"context\": {\n                    \"lat\": requestedX,\n                    \"lng\": requestedY\n                }\n            }\n        }\n    };\n\n    // Increase the cost for each properly received response\n    var cost = flow.get('cost') || 0;\n    cost += 0.01;\n    flow.set('cost', Number(cost.toFixed(2)));\n\n    return newMsg;\n}\n\n// If the ID in the request and response don't match,\n// ignore the message\nreturn null;",
