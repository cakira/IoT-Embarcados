    {
        "id": "b9b7eb6f5bfe75dc",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Format sensorData as JSON for ThingSpeak",
        "func": "// Get the current sensors from memory\nvar sensors = flow.get('sensorData') || {};\nvar sensorArray = [];\n\n// Loop through and format them into an array\nfor (var id in sensors) {\n    if (sensors.hasOwnProperty(id)) {\n        sensorArray.push({\n            \"id\": id,\n            \"lat\": sensors[id].lat,\n            \"lon\": sensors[id].lon,\n            \"temp\": sensors[id].temp\n        });\n    }\n}\n\n// Do not send if we don't have enough data yet\nif (sensorArray.length < 3) {\n    return null; \n}\n\n// Build the ThingSpeak payload\nmsg.payload = {\n    \"api_key\": \"A6KWFLMYP28AJT0A\",\n    \"field1\": JSON.stringify({ \"sensors\": sensorArray })\n};\n\n// Set headers for a JSON POST request\nmsg.headers = {\n    \"Content-Type\": \"application/json\"\n};\n\nreturn msg;",
